# Clampd Configuration
# Copy to .env and fill in your values:
#   cp .env.example .env

# ─── License (required) ────────────────────────────────────────────
# Sign up at https://license.clampd.dev to get your license key.
# Then activate: clampd license activate --license "$CLAMPD_LICENSE_KEY"
CLAMPD_LICENSE_KEY=

# ─── Security (REQUIRED) ─────────────────────────────────────────
# All secrets below MUST be set. The stack will refuse to start without them.

# REQUIRED - Generate with: openssl rand -hex 32
# Must be at least 32 characters.
JWT_SECRET=

# REQUIRED - Generate with: openssl rand -hex 16
POSTGRES_PASSWORD=

# REQUIRED - Generate with: openssl rand -hex 16
REDIS_PASSWORD=

# REQUIRED - Generate with: openssl rand -hex 64
# Used for internal service-to-service authentication.
AG_INTERNAL_SECRET=

# REQUIRED - Generate with: openssl rand -hex 32
# Token for NATS message bus authentication.
NATS_TOKEN=

# Shadow event signing — prevents spoofed NATS events.
# Generate with: openssl rand -hex 32
# AG_HMAC_SECRET=

# ─── Database ────────────────────────────────────────────────────
# Default: local Postgres container. For managed DB (Neon, Supabase):
# DATABASE_URL=postgresql://user:pass@host:5432/dbname?sslmode=require
# REDIS_URL=redis://:password@host:6379

# ─── Dashboard ───────────────────────────────────────────────────
# Required for the dashboard (app.clampd.dev / self-hosted dashboard).
# DASHBOARD_URL=https://app.clampd.dev
# NEXT_PUBLIC_API_URL=https://api.clampd.dev

# Google OAuth (optional - for Google sign-in on dashboard)
# Get credentials at: https://console.cloud.google.com/apis/credentials
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Email notifications (optional - uses Resend)
# RESEND_API_KEY=
# EMAIL_FROM=Clampd <noreply@yourdomain.com>

# SSO callback URL (consumed by dashboard-api SSO routes)
# SSO_CALLBACK_URL=https://api.clampd.dev/v1/auth/sso/callback

# ─── ClickHouse (optional - for analytics) ───────────────────────
# Set CLICKHOUSE_ENABLED=false (or leave CLICKHOUSE_URL empty) to run
# ag-shadow in NATS-drain-and-drop mode — no analytics persistence, but
# JetStream won't back up and dashboard queries return CLICKHOUSE_UNAVAILABLE.
# CLICKHOUSE_ENABLED=true
# CLICKHOUSE_URL=https://host:8443
# CLICKHOUSE_USER=default
# CLICKHOUSE_PASSWORD=

# ─── Gateway TLS (HIPAA/PCI-DSS compliance) ─────────────────────
# External-facing TLS for ag-gateway HTTP listener.
# For production, use Let's Encrypt (via Caddy) or your CA's cert.
# CLAMPD_TLS_CERT=/tls/clampd-gateway.pem
# CLAMPD_TLS_KEY=/tls/clampd-gateway-key.pem
# CLAMPD_ENV=production     # Enforces TLS - gateway refuses to start without cert/key

# ─── gRPC TLS (internal service-to-service) ──────────────────────
# When set, all gRPC servers use TLS and clients verify server certs.
# Omit all three to run plaintext gRPC (suitable for dev/Docker networks).
# AG_GRPC_TLS_CERT=/certs/server.pem
# AG_GRPC_TLS_KEY=/certs/server-key.pem
# AG_GRPC_TLS_CA=/certs/ca.pem

# ─── Connection pool & concurrency ───────────────────────────────
# Shared by all Rust services unless overridden per service.
# REDIS_POOL_MAX_SIZE=16
# AG_POLICY_REDIS_POOL_SIZE=32
# Cap on in-flight HTTP requests at ag-gateway — when reached, excess
# requests return 503 instead of starving Redis and returning 500.
# GATEWAY_MAX_CONCURRENCY=1024

# ─── gRPC client tuning (ag-common, all services) ────────────────
# AG_GRPC_TIMEOUT_SECS=3           # per-RPC timeout — raise for LLM-judge escalation
# AG_GRPC_CONNECT_TIMEOUT_SECS=5
# AG_GRPC_KEEP_ALIVE_SECS=10       # HTTP/2 ping interval
# AG_GRPC_TCP_KEEPALIVE_SECS=30

# ─── Circuit breaker (gateway → downstream gRPCs) ────────────────
# AG_CB_FAILURE_THRESHOLD=5
# AG_CB_RECOVERY_TIMEOUT_SECS=30
# AG_CB_HALF_OPEN_MAX=3

# ─── ag-token (OAuth credential broker) ──────────────────────────
# AG_TOKEN_ENCRYPTION_KEY=                 # 64 hex chars; required if broker enabled
# AG_TOKEN_ALLOW_PLAINTEXT_SEED=false
# AG_TOKEN_GLOBAL_RATE_LIMIT=10000
# AG_TOKEN_GLOBAL_RATE_WINDOW=60
# AG_TOKEN_DEGRADATION_MODE=strict         # strict | permissive
# AG_TOKEN_DEGRADED_TTL_SECS=300
# AG_TOKEN_MAX_DEGRADED_DURATION_SECS=3600

# ─── Identity provider (IdP) bridge ──────────────────────────────
# IDP_TOKEN_ENDPOINT=
# IDP_CLIENT_ID=
# IDP_CLIENT_SECRET=
# IDP_AUDIENCE=
# CLAMPD_IDP_ADMIN_TOKEN=
# CLAMPD_IDP_ADMIN_BASE_URL=
# CLAMPD_IDP_REVOKE_TIMEOUT_MS=5000

# ─── ag-policy ───────────────────────────────────────────────────
# AG_POLICY_CACHE_TTL_SECS=30
# AG_POLICY_CACHE_MAX_ENTRIES=10000
# AG_POLICY_CACHE_HIGH_CONFIDENCE_TTL_SECS=300
# AG_POLICY_METRICS_PORT=9091
# AG_POLICY_LOGISTIC_ENABLED=false
# AG_POLICY_LOGISTIC_SLOPE=1.0

# ─── ag-intent ───────────────────────────────────────────────────
# Short-TTL in-memory cache around the L1 rule evaluator
# (CompiledRuleset::evaluate_full). Absorbs retry storms — identical
# request bodies within TTL skip rule re-evaluation. The eval is a pure
# function of (ruleset checksum, tool, action, params, scope, agent id,
# overrides, bucketed agent_risk_score); session/delegation/encoding
# signals are folded in AFTER the cache and correctly do not gate it.
# Periodic hit-rate stats emit on the `eval_cache.stats` log event.
# AG_INTENT_EVAL_CACHE_TTL_SECS=5
# AG_INTENT_EVAL_CACHE_MAX=10000
# AG_INTENT_EVAL_CACHE_DISABLED=     # any non-empty value disables

# ─── ag-risk ─────────────────────────────────────────────────────
# AG_RISK_ANOMALY_PERCENTILE=95
# AG_RISK_METRICS_PORT=9092
# AG_RISK_LEADER_FOLLOWER=false

# ─── ag-gateway — risk, model escalation, LLM judge ──────────────
# RISK_THRESHOLD=0.70
# MODEL_ESCALATION_ENABLED=false
# MODEL_ESCALATION_GRAY_LOW=0.2
# MODEL_ESCALATION_GRAY_HIGH=0.75
# MODEL_ESCALATION_TIMEOUT_MS=500
# MODEL_ESCALATION_MAX_RPM=60
# MODEL_ESCALATION_MAX_FAILURES=5
# MODEL_ESCALATION_COOLDOWN_SECS=60
# MODEL_URL=
# MODEL_ONNX_PATH=
# MODEL_FAIL_OPEN=true
#
# LLM-as-judge (optional 5th layer for ambiguous prompts):
# CLAMPD_LLM_JUDGE_ENABLED=false
# CLAMPD_LLM_JUDGE_PROVIDER=openai          # openai | anthropic | azure
# CLAMPD_LLM_JUDGE_MODEL=gpt-4o-mini
# CLAMPD_LLM_JUDGE_API_KEY=
# CLAMPD_LLM_JUDGE_BASE_URL=
# CLAMPD_LLM_JUDGE_TIMEOUT_MS=2000
# CLAMPD_LLM_JUDGE_FAIL_OPEN=true
# CLAMPD_LLM_JUDGE_MAX_RPM=60
# CLAMPD_LLM_JUDGE_MAX_FAILURES=5
# CLAMPD_LLM_JUDGE_COOLDOWN_SECS=60

# Session/DoS caps (gateway):
# CLAMPD_MAX_CALLS_PER_SESSION=1000
# CLAMPD_MAX_SESSIONS_PER_HOUR=100
# AG_SCOPE_TOKEN_TTL_SECS=300

# Caching:
# CLAMPD_BASELINE_CACHE_TTL_SECS=60
# CLAMPD_BASELINE_CACHE_MAX_ENTRIES=10000
# CLAMPD_TENANT_ENTITIES_TTL_SECS=15       # per-org entity SCAN cache

# Intent tuning:
# CLAMPD_INTERLEAVE_MIN_CHANGES=3
# CLAMPD_THREAT_FEED_API_KEY=

# Rule engine:
# CLAMPD_TOOL_DIVERSITY_THRESHOLD=5
# CLAMPD_VOLUME_ANOMALY_MULTIPLIER=5
# CLAMPD_SLOW_DRIP_MULTIPLIER=2
# CLAMPD_SLOW_DRIP_MIN_RECORDS=1000
# CLAMPD_DICTIONARY_PATH=                   # external keyword JSON

# Delegation:
# CLAMPD_MAX_DELEGATION_DEPTH=5

# ─── ag-kill ─────────────────────────────────────────────────────
# AG_KILL_DENY_TTL_SECS=86400               # 1 day
# AG_KILL_DENY_EXTENDED_TTL_SECS=604800     # 7 days

# ─── ag-shadow (audit log) ───────────────────────────────────────
# AG_SHADOW_LEADER_FOLLOWER=false
# AG_SHADOW_OVERFLOW_DIR=                   # file fallback when NATS JetStream full
# CLAMPD_SHADOW_LAG_WARN=10000
# CLAMPD_SHADOW_LAG_CRITICAL=100000

# ─── ag-control ──────────────────────────────────────────────────
# CLAMPD_WS_ENABLED=true                    # WebSocket to dashboard-api
# CLAMPD_WS_MAX_BACKOFF=60
# CLAMPD_DELEGATION_OPA_SYNC_SECS=15

# ─── Observability & identity ────────────────────────────────────
# OTEL_EXPORTER_OTLP_ENDPOINT=              # OTLP/gRPC (e.g. http://otel-collector:4317)
# POD_NAME=                                 # overrides auto UUID in logs + leader election
# CLAMPD_DEPLOYMENT_KEY_PATH=
# CLAMPD_MACHINE_ID=
# CLAMPD_ACTIVATION_PATH=
# CLAMPD_TRUST_CACHE_MAX=1024

# ─── ag-token encryption (REQUIRED) ────────────────────────────────────
# 32-byte base64-encoded key for AES-256-GCM at-rest encryption of
# ag-token signing seeds in Redis. Generate: openssl rand -base64 32
AG_TOKEN_ENCRYPTION_KEY=

# ─── LLM-as-Judge (optional, off by default) ──────────────────────────
# Gray-zone arbitration: when intent risk score lands between LOW and
# HIGH, ag-gateway can call an LLM to make the allow/block decision.
CLAMPD_LLM_JUDGE_ENABLED=false
CLAMPD_LLM_JUDGE_PROVIDER=openai
CLAMPD_LLM_JUDGE_MODEL=gpt-4o-mini
CLAMPD_LLM_JUDGE_API_KEY=
# CLAMPD_LLM_JUDGE_BASE_URL=https://api.openai.com/v1
CLAMPD_LLM_JUDGE_TIMEOUT_MS=3000
CLAMPD_LLM_JUDGE_FAIL_OPEN=true
CLAMPD_LLM_JUDGE_MAX_RPM=60
CLAMPD_LLM_JUDGE_LOW=0.2
CLAMPD_LLM_JUDGE_HIGH=0.75

# ─── A2A delegation crypto signing (optional) ─────────────────────────
# When "on", delegation headers are HMAC-signed and verified across
# the chain (defense against forged delegation claims).
CLAMPD_DELEGATION_SIGNATURES=off

# ─── ClickHouse audit pipeline (default on) ───────────────────────────
# Set to "false" to disable shadow→ClickHouse audit writes (events
# still go to Postgres). Useful when running without ClickHouse.
CLICKHOUSE_ENABLED=true

# ─── Bundles auto-fetch (dashboard) ───────────────────────────────────
# Disable upstream bundle fetching, or override the bundles repo URL.
# Defaults: enabled, fetching from github.com/clampd/bundles
CLAMPD_BUNDLES_FETCH_DISABLED=
CLAMPD_BUNDLES_UPSTREAM_URL=
